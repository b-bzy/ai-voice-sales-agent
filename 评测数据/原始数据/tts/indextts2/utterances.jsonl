{"model": "indextts2", "mode": "voice_clone_stream_return", "text_id": "blind_02", "text": "A chuva passou durante a madrugada e a cidade amanheceu silenciosa, com um vento frio vindo do mar.", "reference_audio": "<internal-src>/stt/dev/common_voice_pt_19289339.wav", "reference_text": "era incrivelmente quente não uma nuvem no céu nem um sopro de vento", "audio_path": "<internal-src>/tts/benchmarks/indextts2/20260420_150046/indextts2/blind_02.wav", "sample_rate": null, "audio_duration_s": 9.044172335600907, "synth_time_s": 14.557082085986622, "rtf": 1.6095538149671305, "first_chunk_latency_ms": 14551.272279000841, "peak_rss_mb": 3730.15234375, "peak_cuda_mb": 7332.591796875, "error": null}
